     "max": 4.198859974030252
    }
   }
  },
  {
   "id": "scene_cam_intrinsics",
   "required": false,
   "what": "The overhead scene_cam is spawned the same way (from_intrinsic_matrix), so it too renders a centred principal point and mean focal length; apply the same choice once SCENE_K is calibrated.",
   "why": "Same IsaacLab conversion; not measured here."
  }
 ]
